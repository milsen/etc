# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!
#
# This config file uses keycodes (bindsym) and was written for the QWERTY
# layout.
#
# To get a config file with the same key positions, but for your current
# layout, use the i3-config-wizard

# colors
set $foreground "#c9ccca"
set $color0     "#14181f"
set $color1     "#b84747"
set $color2     "#518234"
set $color3     "#e0925c"
set $color4     "#4f7798"
set $color5     "#a582b0"
set $color6     "#52b6a9"
set $color7     "#7c838b"
set $color8     "#32353a"
set $color9     "#d25d5d"
set $color10    "#bdc75e"
set $color11    "#ebc273"
set $color12    "#83a7c5"
set $color13    "#c8afce"
set $color14    "#82b8b1"
set $color15    "#c9ccca"

# class                 border   backgr. text        indicator child_border
client.focused          $color11 $color0 $foreground $color13  $color11
client.focused_inactive $color12 $color0 $foreground $color13  $color12
client.unfocused        $color7  $color0 $foreground $color13  $color7
client.urgent           $color9  $color0 $foreground $color13  $color9
client.placeholder      $color14 $color0 $foreground $color13  $color14
client.background       $color0

# window borders
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# Set Super as modifier key
set $mod Mod4

# Let Super trigger Super+Escape when release in less than 200ms
# (this combi is later bound to the launcher)
exec_always xcape -t 200 -e 'Super_L=Super_L|Escape'

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:Terminus (TTF) 16px

# Before i3 v4.8, we used to recommend this one as the default:
# font -misc-fixed-medium-r-normal--13-120-75-75-C-70-iso10646-1
# The font above is very space-efficient, that is, it looks good, sharp and
# clear in small sizes. However, its unicode glyph coverage is limited, the old
# X core fonts rendering does not support right-to-left and this being a bitmap
# font, it doesn't scale on retina/hidpi displays.

# use these keys for focus, movement, and resize directions when reaching for
# the arrows is not convenient
set $up k
set $down j
set $left h
set $right l

# use Mouse+Mod1 to drag floating windows to their wanted position
floating_modifier $mod

# start a terminal
bindsym $mod+Return exec alacritty
bindsym $mod+t exec alacritty

# kill focused window
bindsym $mod+d kill

# change focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Mod1+$left move left
bindsym $mod+Mod1+$down move down
bindsym $mod+Mod1+$up move up
bindsym $mod+Mod1+$right move right

# alternatively, you can use the cursor keys:
bindsym $mod+Mod1+Left move left
bindsym $mod+Mod1+Down move down
bindsym $mod+Mod1+Up move up
bindsym $mod+Mod1+Right move right

# split in horizontal orientation
bindsym $mod+x split h

# split in vertical orientation
bindsym $mod+y split v

# enter fullscreen mode for the focused container
bindsym $mod+Mod1+space fullscreen toggle

# change container layout (stacked, tabbed, splith, splitv)
bindsym $mod+space layout toggle tabbed split
bindsym $mod+s layout toggle split
bindsym $mod+Mod1+s layout stacking

# toggle tiling / floating
bindsym $mod+f floating toggle

# change focus between tiling / floating windows
bindsym $mod+Mod1+f focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
bindsym $mod+Mod1+a focus child

# move the currently focused window to the scratchpad
bindsym $mod+Mod1+minus move scratchpad

# Show the next scratchpad window or hide the focused scratchpad window.
# If there are multiple scratchpad windows, this command cycles through them.
bindsym $mod+minus scratchpad show

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

# move focused container to workspace
bindsym $mod+Mod1+1 move container to workspace $ws1
bindsym $mod+Mod1+2 move container to workspace $ws2
bindsym $mod+Mod1+3 move container to workspace $ws3
bindsym $mod+Mod1+4 move container to workspace $ws4
bindsym $mod+Mod1+5 move container to workspace $ws5
bindsym $mod+Mod1+6 move container to workspace $ws6
bindsym $mod+Mod1+7 move container to workspace $ws7
bindsym $mod+Mod1+8 move container to workspace $ws8
bindsym $mod+Mod1+9 move container to workspace $ws9
bindsym $mod+Mod1+0 move container to workspace $ws10

# reload the configuration file
bindsym $mod+r reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Mod1+r restart
# exit i3 (logs you out of your X session)
bindsym $mod+Mod1+q exec "i3-msg exit"

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym $left       resize shrink width 10 px or 10 ppt
        bindsym $down       resize grow height 10 px or 10 ppt
        bindsym $up         resize shrink height 10 px or 10 ppt
        bindsym $right      resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left        resize shrink width 10 px or 10 ppt
        bindsym Down        resize grow height 10 px or 10 ppt
        bindsym Up          resize shrink height 10 px or 10 ppt
        bindsym Right       resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+plus mode "default"
}

bindsym $mod+plus mode "resize"

# polybar
exec_always --no-startup-id $HOME/.config/polybar/launch.sh
bindsym $mod+b exec polybar-msg cmd toggle

# Applications
bindsym $mod+Escape      exec rofi -show combi
bindsym $mod+c           exec rofi -show calc -no-show-match -no-sort
bindsym $mod+e           exec rofi -show emoji
bindsym $mod+o           exec alacritty -t music-player -e music-player
bindsym $mod+Mod1+o      exec alacritty -t music-player -e music -p
bindsym $mod+p           exec mpc -q toggle
bindsym $mod+g           exec alacritty -e ranger
bindsym $mod+i           workspace 1; exec firefox
bindsym $mod+u           workspace 8; exec signal-desktop; exec ferdium
bindsym $mod+Mod1+i      workspace 9; exec thunderbird
bindsym $mod+z           workspace 10; exec keepassxc
bindsym $mod+Print       exec "scrot '%Y-%m-%d_%H-%M-%S.png' -ze 'mv $f ~/media/images/shots' && notify-send 'Screenshot taken'"

# dunst
bindsym $mod+comma       exec dunstctl close
bindsym $mod+Mod1+comma  exec dunstctl close-all
bindsym $mod+period      exec dunstctl history-pop
bindsym $mod+Mod1+period exec dunstctl context

bindsym $mod+asciicircum      exec i3lock -c 32353a
bindsym $mod+Mod1+asciicircum exec --no-startup-id (sleep 0.5 && systemctl suspend) &

# Multimedia keys
bindsym XF86AudioMute         exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle >/dev/null
bindsym XF86AudioRaiseVolume  exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ >/dev/null
bindsym XF86AudioLowerVolume  exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- >/dev/null
bindsym XF86AudioMicMute      exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null
bindsym XF86MonBrightnessDown exec xbacklight -dec 10 >/dev/null
bindsym XF86MonBrightnessUp   exec xbacklight -inc 10 >/dev/null

for_window [title="^ZynAddSubFX.*$"] floating enable
for_window [title="^cover art$"] floating enable
for_window [title="^music-player$"] floating enable
for_window [title="^music-player$"] resize set 1008 756
for_window [title="^music-player$"] move position center
for_window [title="^gimp-toolbox$"] floating enable
for_window [title="^octave-gui$"] floating enable
no_focus [title="^cover art$"]
